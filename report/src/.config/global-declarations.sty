\newcommand{\inlinecode}[1]{
    \tikz[baseline]{%
        \node[anchor= base, text= tagtxt, fill= backg, font= \normalfont\ttfamily, text depth= 0.5mm, rounded corners= 1pt, inner sep= 2pt] {#1};
    }%
}

\newcommand{\counterproofqed}{%
    \tikz[x= 0.22em, y= 0.22em, line width= 0.032em] {%
        \draw (0, 2.83) -- (2.83, 0) (0.71, 3.54) -- (3.54, 0.71) (0, 0.71) -- (2.83, 3.54) (0.71, 0) -- (3.54, 2.83);
    }
}

\newcommand{\proofbox}{%
    \tikz {%
        \draw[black, fill= black] (0, 0) rectangle (0.22, 0.22);
    }
}

